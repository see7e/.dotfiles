{
    "security.workspace.trust.untrustedFiles": "open",

    "files.eol": "\n",
    "files.autoSave": "onFocusChange",

    "window.menuBarVisibility": "compact",

    "workbench.startupEditor": "none",
    "workbench.activityBar.location": "hidden",
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.labelFormat": "short",
    "workbench.layoutControl.enabled": false,
    "workbench.colorTheme": "GitHub Dark Default",

    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.compactFolders": false,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
        "*.templ": "${capture}_templ.go,${capture}_templ.txt",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    
    "editor.minimap.enabled": false,
    // "editor.minimap.autohide": true,
    // "editor.minimap.maxColumn": 100,
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "editor.stickyScroll.enabled": false,
    "editor.codeActionsOnSave": {},
    "editor.lineNumbers": "relative",
    "editor.rulers": [
        80, 120
    ],
    "diffEditor.ignoreTrimWhitespace": false,
    
    // "codestream.serverUrl": "https://eu-api.codestream.com",
    // Langs
    "[python]": {
        "editor.formatOnType": true,
        "editor.rulers": [80, 100]
    },
    
    "[c]": {
        "editor.formatOnType": true,
        "editor.rulers": [80]
    },

    "[html]": {
        "editor.suggest.insertMode": "replace"
    },

    // Extensions
    "go.inferGopath": true,
    "go.alternateTools": {},
    "go.toolsManagement.autoUpdate": true,

    "python.radon.enable": true,
    "pylint.args": [
        "--disable=C0111", "--max-line-length=120"
    ],

    "symbols.hidesExplorerArrows": false,

    "remote.autoForwardPortsSource": "hybrid",

    "vim.autoindent": true,
    "vim.smartRelativeLine": true,
    
    "git.autofetch": true,
    "git-graph.repository.commits.order": "topo",
    "git-graph.commitDetailsView.location": "Docked to Bottom",
    "git-graph.referenceLabels.alignment": "Branches (aligned to the graph) & Tags (on the right)",
    "githubPullRequests.pullBranch": "never",
    "githubLocalActions.dockerDesktopPath": "C:/Program Files/Docker/Docker/Docker Desktop.exe",
    "gitlens.codeLens.enabled": false,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.defaultDateLocale": null,
    "git.enableSmartCommit": true,
    "git.ignoreRebaseWarning": true,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
    "github.copilot.editor.enableAutoCompletions": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.advanced": {
        "authProvider": "github"
    }
}
